+    /// A camera-only pass: keep the driver's post-processing and HUD out of the capture.
+    pub fn render_camera_image(&mut self, scene:&mut Scene,width:u32,height:u32,camera:&Camera,lighting:&Lighting)->anyhow::Result<Vec<u8>> {
+        // Use the same square target size as the game's working mirror path.
+        let id=self.add_render_texture(scene,512,512);
+        self.render_to_texture(scene,id,camera,lighting,width as f32/height as f32);
+        let result=self.read_render_texture(scene,id).map(|(w,h,source)|{
+            let mut rgba=vec![0;(width*height*4) as usize];
+            for y in 0..height { for x in 0..width {
+                let from=(((y*h/height)*w+x*w/width)*4) as usize;
+                let to=((y*width+x)*4) as usize;
+                rgba[to..to+4].copy_from_slice(&source[from..from+4]);
+            }}
+            rgba
+        });
+        // read_render_texture waits for the GPU, so the temporary target can be released.
+        if scene.textures.len()==id+1 { scene.textures.pop(); }
+        result
+    }
+
+    /// Read a completed render target without changing the player's view.
+    pub fn read_render_texture(&self, scene:&Scene,id:TextureId)->anyhow::Result<(u32,u32,Vec<u8>)> {
+        let texture=scene.textures.get(id).ok_or_else(||anyhow::anyhow!("No mirror texture"))?;
+        let mut rgba=self.read_texture(&texture.texture,wgpu::TextureAspect::All)?;
+        if matches!(texture.texture.format(),wgpu::TextureFormat::Bgra8Unorm|wgpu::TextureFormat::Bgra8UnormSrgb) {
+            for pixel in rgba.chunks_exact_mut(4){pixel.swap(0,2);}
+        }
+        Ok((texture.size.0,texture.size.1,rgba))
     }
 
     /// Render the scene from `camera` into a texture made by `add_render_texture`.
