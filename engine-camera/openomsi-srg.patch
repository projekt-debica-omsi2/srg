+                &args(&[
+                    "--bus",
+                    "Vehicles/x.bus",
+                    "--spawn",
+                    "10,20,90",
+                    "--cam",
+                    "5000,6000,50,0,0"
+                ]),
+                &cam,
+                None
+            ),
+            seat
+        );
+        // ... and with the free camera: both places
+        let both = start_centers(
+            &args(&[
+                "--bus",
+                "Vehicles/x.bus",
+                "--spawn",
+                "10,20,90",
+                "--cam",
+                "5000,6000,50,0,0",
+                "--view",
+                "free",
+            ]),
+            &cam,
+            None,
