+//! Opt-in, local-only independent camera output for SRGMobile.
+//! The driver camera and input are never changed. A short request lease bounds GPU work.
+use crate::player::Player;
+use omsi_render::{Camera, Lighting, Renderer, Scene};
+use serde::{Deserialize, Serialize};
+use std::sync::{Mutex, OnceLock, mpsc};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+#[derive(Deserialize)]
+struct Request { channel: u16, #[serde(default)] channels: Vec<u16>, updated: f64 }
+#[derive(Clone, Serialize)]
+struct Feed { channel: u16, label: String }
+#[derive(Serialize)]
+struct Meta { channel: u16, updated: f64, source: String, available: Vec<u16>, feeds: Vec<Feed>, error: Option<String> }
+struct Frame { rgba: Vec<u8>, meta: Meta }
+struct Exporter { next: usize, last: Option<Instant>, tx: mpsc::SyncSender<Frame> }
+static EXPORT: OnceLock<Mutex<Exporter>> = OnceLock::new();
+const WIDTH: u32 = 480;
+const HEIGHT: u32 = 270;
+fn folder() -> Option<std::path::PathBuf> {
+    std::env::var_os("LOCALAPPDATA").map(|p| std::path::PathBuf::from(p).join("SRG-OMSI"))
+}
+fn camera_channel(channel:u16)->bool { channel<=3 || (16..272).contains(&channel) }
+fn active_request(request:&Request,now:f64)->bool { camera_channel(request.channel) && request.channels.len()<=4 && request.channels.iter().all(|&c|camera_channel(c)) && request.updated.is_finite() && now-request.updated<=2.0 && request.updated-now<=2.0 }
+fn unix_now() -> f64 { SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs_f64() }
+fn exporter() -> &'static Mutex<Exporter> {
+    EXPORT.get_or_init(|| {
+        let (tx, rx) = mpsc::sync_channel::<Frame>(1);
+        std::thread::spawn(move || {
+            while let Ok(frame) = rx.recv() {
+                let Some(root) = folder() else { continue };
+                if std::fs::create_dir_all(&root).is_err() { continue; }
+                if frame.meta.error.is_none() {
+                    let mut rgb = Vec::with_capacity((WIDTH * HEIGHT * 3) as usize);
+                    for pixel in frame.rgba.chunks_exact(4) { rgb.extend_from_slice(&pixel[..3]); }
+                    let mut jpeg = Vec::new();
+                    if jpeg_encoder::Encoder::new(&mut jpeg, 65).encode(&rgb, WIDTH as u16, HEIGHT as u16, jpeg_encoder::ColorType::Rgb).is_err() { continue; }
+                    // Publish a completed image before its freshness metadata.
+                    let path=root.join(format!("camera-{}.jpg",frame.meta.channel));
+                    let temp=root.join(format!("camera-{}.tmp",frame.meta.channel));
+                    if std::fs::write(&temp, jpeg).is_err() { continue; }
+                    // MoveFileExW atomically replaces an existing completed frame.
+                    #[cfg(windows)]
+                    {
+                        use std::os::windows::ffi::OsStrExt;
+                        let from:Vec<u16>=temp.as_os_str().encode_wide().chain(Some(0)).collect();
+                        let to:Vec<u16>=path.as_os_str().encode_wide().chain(Some(0)).collect();
+                        #[link(name="kernel32")]
+                        unsafe extern "system" { fn MoveFileExW(from:*const u16,to:*const u16,flags:u32)->i32; }
+                        if unsafe { MoveFileExW(from.as_ptr(),to.as_ptr(),1) }==0 { continue; }
+                    }
+                    #[cfg(not(windows))]
+                    if std::fs::rename(&temp,&path).is_err() { continue; }
+                }
+                if let Ok(meta)=serde_json::to_vec(&frame.meta) {
+                    let _=std::fs::write(root.join(format!("camera-{}.json",frame.meta.channel)),meta);
+                }
+            }
+        });
+        Mutex::new(Exporter { next: 0, last: None, tx })
+    })
+}
+
+pub(crate) fn tick(renderer:&mut Renderer,scene:&mut Scene,player:Option<&Player>,fallback:&Camera,lighting:&Lighting,world:Option<&crate::scene::World>) {
+    let Some(root)=folder() else { return };
+    // An absent request costs no extra render pass and starts no worker.
+    let Ok(bytes)=std::fs::read(root.join("camera-request.json")) else { return };
+    if bytes.len()>1024 { return; }
+    let Ok(mut request)=serde_json::from_slice::<Request>(&bytes) else { return };
+    let now=unix_now();
+    if !active_request(&request,now) { return; }
+    let Ok(mut output)=exporter().try_lock() else { return };
+    if output.last.is_some_and(|last|last.elapsed()<Duration::from_millis(250)) { return; }
+    output.last=Some(Instant::now());
+    if !request.channels.is_empty() {
+        request.channel=request.channels[output.next%request.channels.len()];output.next=output.next.wrapping_add(1);
+    }
+    let mut available=Vec::new();
+    let mut feeds=Vec::new();
+    let selected=player.and_then(|p| {
+        if p.pax_camera_count()>0 { available.push(0); }
+        let left=crate::mirror_hud::side_mirror(p,false);
+        let right=crate::mirror_hud::side_mirror(p,true);
+        let inside=p.vehicle.ty.def.cameras_reflexion.iter().enumerate()
+            .filter(|(_,c)|!c.fixed && c.pos[0].abs()<0.8)
+            .max_by(|a,b|a.1.pos[1].partial_cmp(&b.1.pos[1]).unwrap_or(std::cmp::Ordering::Equal)).map(|(i,_)|i);
+        if let Some(index)=inside { if index<256 { feeds.push(Feed{channel:16+index as u16,label:"Lusterko wewnętrzne".into()}); } }
+        if p.pax_camera_count()>0 { feeds.push(Feed{channel:0,label:"Wnętrze — kamera pasażerska".into()}); }
+        let mirrors:Vec<_>=p.vehicle.ty.def.cameras_reflexion.iter().chain(p.vehicle.trailers.iter().flat_map(|t|t.ty.def.cameras_reflexion.iter())).take(256).collect();
+        for index in 0..mirrors.len() {
+            available.push(16+index as u16);
+            if Some(index)!=inside { feeds.push(Feed{channel:16+index as u16,label:if Some(index)==left {"Lewe lusterko / kamera".into()} else if Some(index)==right {"Prawe lusterko / kamera".into()} else {format!("Kamera / lusterko {}",index+1)}}); }
+        }
+        if left.is_some(){available.push(1);}if right.is_some(){available.push(2);}if inside.is_some(){available.push(3);if !available.contains(&0){available.push(0);}}
+        match request.channel {
+            0 if p.pax_camera_count()>0 => Some((p.camera_look("pax",fallback,(0.0,0.0),10.0),"Wnętrze — kamera pasażerska",false,None)),
+            0 => inside.map(|n|(p.camera_look(&format!("mirror{n}"),fallback,(0.0,0.0),10.0),"Wnętrze — lusterko",true,Some(n))),
+            1 => left.map(|n|(p.camera_look(&format!("mirror{n}"),fallback,(0.0,0.0),10.0),"Lusterko lewe",true,Some(n))),
+            2 => right.map(|n|(p.camera_look(&format!("mirror{n}"),fallback,(0.0,0.0),10.0),"Lusterko prawe",true,Some(n))),
+            3 => inside.map(|n|(p.camera_look(&format!("mirror{n}"),fallback,(0.0,0.0),10.0),"Lusterko wewnętrzne",true,Some(n))),
+            channel if channel>=16 => {
+                let index=(channel-16) as usize;
+                mirrors.get(index).map(|c|(p.camera_look(&format!("mirror{index}"),fallback,(0.0,0.0),10.0),"Kamera / lusterko z modelu autobusu",!c.fixed,Some(index)))
+            }
+            _ => None,
+        }
+    });
+    let mut meta=Meta { channel:request.channel,updated:now,source:String::new(),available,feeds,error:None };
+    let Some((mut camera,mut label,mut mirror,mirror_index))=selected else {
+        meta.error=Some("Ten autobus nie udostępnia wybranej kamery/lusterka".into());
+        let _=output.tx.try_send(Frame{rgba:Vec::new(),meta});return;
+    };
+    camera.far=camera.far.min(450.0);
+    let image=if let (Some(index),Some(world),Some(player))=(mirror_index,world,player) {
+        crate::camera_util::render_mirrors(renderer,scene,world,player,lighting,crate::camera_util::MirrorPick::Only(&[index]),None,&[index]);
+        let id=world.mirror_textures.lock().get(index).copied().flatten();
+        match id {
+            Some(id)=>renderer.read_render_texture(scene,id).and_then(|(w,h,rgba)|{
+                let image=image::RgbaImage::from_raw(w,h,rgba).ok_or_else(||anyhow::anyhow!("Invalid mirror image"))?;
+                Ok(image::imageops::resize(&image,WIDTH,HEIGHT,image::imageops::FilterType::Triangle).into_raw())
+            }),
+            None=>Err(anyhow::anyhow!("Lusterka są wyłączone lub brak tekstury w modelu")),
+        }
+    } else {
+        let overlays=std::mem::take(&mut scene.overlays);
+        let image=renderer.render_camera_image(scene,WIDTH,HEIGHT,&camera,lighting);
+        scene.overlays=overlays;image
+    };
+    match image {
+        Ok(mut rgba)=>{
+            // Some models leave their left reflection entirely blank. Use a real,
+            // independent side camera outside its housing instead of publishing black pixels.
+            if rgba.chunks_exact(4).all(|p|p[0]<2 && p[1]<2 && p[2]<2) {
+                if let (Some(p),Some(index))=(player,mirror_index) {
+                    if crate::mirror_hud::side_mirror(p,false)==Some(index) {
+                        if let Some(def)=p.vehicle.ty.def.cameras_reflexion.get(index) {
+                            let mut def=def.clone();def.pos[0]-=0.5;def.yaw=180.0;def.pitch=-5.0;
+                            let (position,yaw,pitch,roll)=p.vehicle.camera_world_full(&def);
+                            let side=Camera{position,yaw,pitch,roll,fov_deg:60.0,near:0.1,far:450.0};
+                            if let Ok(side)=renderer.render_camera_image(scene,WIDTH,HEIGHT,&side,lighting) {
+                                rgba=side;mirror=false;label="Lewy bok — kamera zewnętrzna";
+                                if let Some(feed)=meta.feeds.iter_mut().find(|f|f.channel==request.channel){feed.label=label.into();}
+                            }
+                        }
+                    }
+                }
+            }
+            if mirror {
+                for row in rgba.chunks_exact_mut(WIDTH as usize*4) {
+                    for x in 0..WIDTH as usize/2 { for c in 0..4 { row.swap(x*4+c,(WIDTH as usize-1-x)*4+c); } }
+                }
+            }
+            meta.source=label.into();let _=output.tx.try_send(Frame{rgba,meta});
+        }
+        Err(error)=>{meta.error=Some(format!("Camera render failed: {error}"));let _=output.tx.try_send(Frame{rgba:Vec::new(),meta});}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn request_lease_expires_and_never_accepts_unknown_channels() {
+        assert!(active_request(&Request{channels:vec![],channel:0,updated:100.0},101.0));
+        assert!(active_request(&Request{channels:vec![],channel:16,updated:100.0},101.0));
+        assert!(!active_request(&Request{channels:vec![],channel:0,updated:100.0},103.0));
+        assert!(!active_request(&Request{channels:vec![],channel:4,updated:100.0},100.0));
+        assert!(!active_request(&Request{channels:vec![],channel:0,updated:f64::NAN},100.0));
+        assert!(!active_request(&Request{channels:vec![],channel:0,updated:110.0},100.0));
+    }
+}
